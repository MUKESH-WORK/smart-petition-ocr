# ==============================================================================
# GDP Assistant - Backend Environment Configuration Template
# ==============================================================================

USE_SQLITE=false

POSTGRES_USER=dro_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dro_grievance_db

DATABASE_URL=postgresql+asyncpg://dro_user:CHANGE_ME_IN_PRODUCTION_PASSWORD@postgres:5432/dro_grievance_db
DATABASE_SYNC_URL=postgresql://dro_user:CHANGE_ME_IN_PRODUCTION_PASSWORD@postgres:5432/dro_grievance_db

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_QUEUE_NAME=ocr_jobs

SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

LLM_PROVIDER=ollama
LLM_API_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL_NAME=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

UPLOAD_DIR=/app/storage/uploads
STATIC_MEDIA_DIR=/app/static/media

OCR_PROVIDER=datalab
DATALAB_API_KEY=CHANGE_ME_DATALAB_API_KEY
DATALAB_API_URL=https://www.datalab.to/api/v1/convert
DATALAB_MODE=accurate
DATALAB_TIMEOUT=160

LLM_FAST_TIMEOUT=75.0
LLM_FULL_TIMEOUT=120.0
