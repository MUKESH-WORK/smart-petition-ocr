# ==============================================================================
# .dockerignore for GDP Assistant All-in-One Production Build
# ==============================================================================

# Git & IDE Metadata
.git
.github
.gitignore
.gitattributes
.agents
.skills
.vscode
.idea
*.log
*.tmp
*.bak*

# Virtual Environments & Package Managers
.venv
venv
ENV
env
backend/.venv
backend/venv
frontend/node_modules
.npm
.pnpm-store

# Python Bytecode & Test Caches
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.coverage
htmlcov

# Frontend Build Output (generated freshly inside Docker multi-stage build)
frontend/dist

# Runtime Uploads, Database Files & Temporary Buffers (persisted via Docker volumes)
temp_cache
backend/temp_cache
uploads
backend/uploads
storage
backend/storage
data/*.db
data/*.sqlite*
backend/data/*.db
backend/data/*.sqlite*
*.db
*.sqlite
*.sqlite3

# Static Generated Media (except placeholder/gitkeep)
static/media/*
backend/static/media/*
!static/media/.gitkeep
!backend/static/media/.gitkeep

# Model Caches (downloaded on demand or mounted)
model_cache
backend/model_cache
models_cache
backend/models_cache

# Backups and Archive Tarballs
scratch
backups
backend/backups
*.tar.gz
*.tar
*.zip

# Local Environment Secrets (never bake secrets into Docker images!)
.env
backend/.env
frontend/.env
frontend/.env.local
