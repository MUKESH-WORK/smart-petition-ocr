POSTGRES_USER=dro_user
POSTGRES_PASSWORD=your_secure_db_password_here          # [REQUIRED] Change in production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dro_grievance_db

DATABASE_URL=postgresql+asyncpg://dro_user:your_secure_db_password_here@localhost:5432/dro_grievance_db
DATABASE_SYNC_URL=postgresql://dro_user:your_secure_db_password_here@localhost:5432/dro_grievance_db


SECRET_KEY=generate_a_secure_random_jwt_secret_key_here  # [REQUIRED] Change in production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440                         # 24 hours
FRONTEND_PORT=80                                           # Change to 8080 or 8088 if port 80 is occupied by Windows IIS/Node
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80,http://localhost,http://localhost:8080,http://localhost:8088
SEED_DEMO_DATA=false
STORE_FILE_BYTEA=false


EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# LLM Cognitive Engine 

LLM_PROVIDER=ollama                                      # [OPTIONAL]
LLM_API_BASE_URL=http://localhost:11434/v1               # Ollama default endpoint
LLM_MODEL_NAME=qwen2.5:3b-instruct                      # Recommended: qwen2.5:3b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# LLM Concurrency, Warmup & Output Preservation
LLM_FAST_TIMEOUT=25.0
LLM_FULL_TIMEOUT=60.0
LLM_MAX_CONCURRENCY=4
LLM_KEEP_ALIVE_INTERVAL=120
LLM_KEEP_ALIVE_ENABLED=true


# OCR Engine 

OCR_PROVIDER=datalab                                     # [OPTIONAL]
DATALAB_API_KEY=your_datalab_api_key_here                # [OPTIONAL] Leave blank for offline mode
DATALAB_API_URL=https://www.datalab.to/api/v1/convert
DATALAB_MODE=accurate
DATALAB_FALLBACK_MODE=balanced
DATALAB_TIMEOUT=45
DATALAB_FALLBACK_TIMEOUT=25

# Local Chandra OCR V2 5.6B Engine (Self-Hosted - 12 FPS)
LOCAL_CHANDRA_ENABLED=false
LOCAL_CHANDRA_URL=http://127.0.0.1:8088/v1
LOCAL_CHANDRA_TIMEOUT=30.0
LOCAL_CHANDRA_BATCH_SIZE=8


# Performance, Workers & Concurrency


OCR_MAX_IMAGE_DIMENSION=1500
OCR_DPI=200
OCR_PREPROCESSING_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=0.8
JOB_MAX_RETRIES=3
JOB_STUCK_TIMEOUT_MINUTES=5
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=20


# AI Semantic Cache 


SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_DAYS=30

# Deduplication & Perceptual Hashing 

DEDUP_EXACT_HASH_ENABLED=true
DEDUP_PHASH_ENABLED=true
DEDUP_PHASH_THRESHOLD=4


# External DRO Portal Bridge


DRO_PORTAL_BASE_URL=http://localhost:9000


# File Storage Paths 


UPLOAD_DIR=uploads
STATIC_MEDIA_DIR=static/media

# ==========================================
# Redis & External Async OCR Queue (Docker Architecture)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
OCR_API_URL=https://your-ocr-provider/api/ocr
OCR_API_KEY=your_api_key
OCR_API_TIMEOUT=60000
OCR_MAX_RETRIES=3
OCR_PROVIDER_NAME=external_ocr
OPENAI_API_KEY=
SARVAM_API_KEY=
ENVIRONMENT=production
