# ==============================================================================
# GDP Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before running Docker Compose:
# Linux/macOS: cp .env.example .env
# Windows:     Copy-Item .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# In Docker Compose, the application communicates with the 'postgres' container.
# Use POSTGRES_HOST=postgres (Docker Compose service name, NOT localhost).
USE_SQLITE=false

POSTGRES_USER=dro_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dro_grievance_db

# Async & Sync SQLAlchemy Connection Strings
DATABASE_URL=postgresql+asyncpg://dro_user:CHANGE_ME_IN_PRODUCTION_PASSWORD@postgres:5432/dro_grievance_db
DATABASE_SYNC_URL=postgresql://dro_user:CHANGE_ME_IN_PRODUCTION_PASSWORD@postgres:5432/dro_grievance_db

# ------------------------------------------------------------------------------
# 2. REDIS (Internal to gdp-assistant container)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_QUEUE_NAME=ocr_jobs

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80

# ------------------------------------------------------------------------------
# 4. OPTICAL CHARACTER RECOGNITION (OCR) CONFIGURATION
# ------------------------------------------------------------------------------
# OCR Provider Options:
#   - 'datalab'   : Deep neural Tamil handwriting OCR via Datalab Chandra API (Recommended)
#   - 'paddleocr' : Local CPU/GPU offline OCR (Zero cloud dependency fallback)
OCR_PROVIDER=datalab

# Datalab Chandra OCR API Key:
# Sign up and get your API key from: https://www.datalab.to
# If left empty or invalid, the system automatically falls back gracefully to offline PaddleOCR.
DATALAB_API_KEY=CHANGE_ME_DATALAB_API_KEY
DATALAB_API_URL=https://www.datalab.to/api/v1/convert
DATALAB_MODE=accurate
DATALAB_TIMEOUT=160
DATALAB_FALLBACK_MODE=balanced
DATALAB_FALLBACK_TIMEOUT=25

# ------------------------------------------------------------------------------
# 5. LARGE LANGUAGE MODEL (LLM) INFERENCE (Host Ollama)
# ------------------------------------------------------------------------------
# In Docker, access host Ollama via 'host.docker.internal:11434'
LLM_PROVIDER=ollama
LLM_API_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model Name (Pull on host machine via: ollama run qwen2.5:3b-instruct)
LLM_MODEL_NAME=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Timeouts in seconds for LLM processing
LLM_FAST_TIMEOUT=75.0
LLM_FULL_TIMEOUT=120.0
LLM_MAX_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 6. VECTOR EMBEDDINGS & SEMANTIC SEARCH
# ------------------------------------------------------------------------------
# Downloads automatically on first container startup if not cached
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ------------------------------------------------------------------------------
# 7. SEMANTIC CACHE & PERFORMANCE
# ------------------------------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_DAYS=30

# ------------------------------------------------------------------------------
# 8. STORAGE & PORTS
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/storage/uploads
STATIC_MEDIA_DIR=/app/static/media
FRONTEND_PORT=80
DRO_PORTAL_BASE_URL=http://localhost:9000
